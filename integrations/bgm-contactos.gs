// BGM_CONTACT_POST_V4 — receives JSON from the BGM server; never lists contacts.
function doPost(e){
 let result;
 try{
  if(!e||!e.postData||!e.postData.contents||e.postData.contents.length>24000)throw new Error('Consulta no válida.');
  const input=JSON.parse(e.postData.contents);
  if(input&&input.action==='bgm-probe-v4')result={ok:true,version:'bgm-contact-post-v4'};
  else result=saveContact(input);
 }catch(error){result={ok:false,error:'No pude confirmar el guardado. Reintenta sin cerrar el formulario.'};}
 return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);
}
