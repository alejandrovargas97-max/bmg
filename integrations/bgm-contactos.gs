const LANGUAGES_=Object.keys(FORM_LABELS_);
const INTERESTS_=['investment','bridge','classes','tournaments','production','education','other'];
function configurarBGM(){
 const who=Session.getActiveUser().getEmail();
 if(!who||who!==Session.getEffectiveUser().getEmail())throw new Error('Ejecuta desde tu editor como propietario.');
 const ss=SpreadsheetApp.getActiveSpreadsheet();
 if(!ss)throw new Error('Abre Apps Script desde la planilla de contactos.');
 const sheets=[...Object.values(LANGUAGE_SHEETS_),'Todo en español'].map(name=>ss.getSheetByName(name));
 sheets.forEach(verifySheet_);
 const lock=LockService.getScriptLock();lock.waitLock(10000);
 try{sheets.forEach(sh=>{if(!codeFirst_(sh))sh.moveColumns(sh.getRange(1,10,sh.getMaxRows(),1),1);});}finally{lock.releaseLock();}
 sheets.forEach(verifySheet_);
 sheets.forEach(setupAppointments_);
 PropertiesService.getScriptProperties().setProperty('BGM_CONTACTS_SHEET',ss.getId());
 console.log('Receptor configurado. Despliega como aplicación web. La planilla sigue privada.');
}
// Appointment follow-up is manual: no email, message or calendar booking is sent.
function setupAppointments_(sh){
 const labels=['Estado de cita','Fecha acordada y zona horaria'];
 const current=sh.getRange(1,23,1,2).getValues()[0];
 if(current.some((v,i)=>v&&v!==labels[i]))throw new Error('Columnas W:X ocupadas; no se sobrescribieron.');
 sh.getRange(1,23,1,2).setValues([labels]);
 const rule=SpreadsheetApp.newDataValidation().requireValueInList(['No solicitada','Pendiente','Confirmada','Realizada','Cancelada'],true).setAllowInvalid(false).build();
 sh.getRange(2,23,sh.getMaxRows()-1,1).setDataValidation(rule);
}
function codeFirst_(sh){return sh.getRange(1,1).getValue()==='Código de ingreso';}
function sheetHeaders_(sh){const h=HEADERS_.slice();if(codeFirst_(sh))h.unshift(h.splice(9,1)[0]);return h;}
function physicalRow_(sh,row){const v=row.slice();if(codeFirst_(sh))v.unshift(v.splice(9,1)[0]);return v;}
function logicalRow_(sh,row){const v=row.slice();if(codeFirst_(sh))v.splice(9,0,v.shift());return v;}
function codeColumn_(sh){return codeFirst_(sh)?1:10;}
function verifySheet_(sh){
 if(!sh||JSON.stringify(sh.getRange(1,1,1,HEADERS_.length).getValues()[0])!==JSON.stringify(sheetHeaders_(sh)))throw new Error('No coincide la estructura de la planilla.');
}
function literal_(v){v=String(v);return /^[=+@\-\t\r]/.test(v)?"'"+v:v;}
function existingRow_(sh,id){const last=sh.getLastRow();return last>1?sh.getRange(2,19,last-1,1).createTextFinder(id).matchEntireCell(true).findNext():null;}
function saveContact(input){
 if(!input||typeof input!=='object'||input.website||input.consent!==true)throw new Error('Consulta no válida.');
 const clean=(v,max)=>{if(typeof v!=='string'||v.length>max)throw new Error('Campo no válido.');return v.trim();};
 const name=clean(input.name,120),email=clean(input.email,254),country=clean(input.country,80),message=clean(input.message,2000),notes=clean(input.notes,2000),contact=clean(input.contact,100),preferred=clean(input.preferredTime,80),zone=clean(input.timeZone,80);
 if(!name||!country||! /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)||!LANGUAGES_.includes(input.language)||!INTERESTS_.includes(input.interest)||! /^[a-f0-9-]{36}$/i.test(input.requestId)||!['email','whatsapp','telegram','wechat'].includes(input.channel)||typeof input.appointment!=='boolean')throw new Error('Consulta no válida.');
 if(input.channel==='whatsapp'&&! /^\+[1-9]\d{6,14}$/.test(contact))throw new Error('WhatsApp: usa + y el número con prefijo internacional.');
 if(input.channel==='telegram'&&! /^@?[A-Za-z][A-Za-z0-9_]{4,31}$/.test(contact))throw new Error('Telegram: indica tu nombre de usuario.');
 if(input.channel==='wechat'&&(!contact||/\s/.test(contact)))throw new Error('WeChat: indica tu ID.');
 if(input.appointment&&(! /^\d{4}-\d\d-\d\dT\d\d:\d\d$/.test(preferred)||!zone))throw new Error('Indica fecha, hora y zona horaria para la cita.');
 const elapsed=Date.now()-Number(input.startedAt);
 if(!Number.isFinite(elapsed)||elapsed<2000||elapsed>86400000)throw new Error('Recarga el formulario.');
 const id=PropertiesService.getScriptProperties().getProperty('BGM_CONTACTS_SHEET');
 if(!id)throw new Error('Receptor pendiente de configurar.');
 const lock=LockService.getScriptLock();lock.waitLock(10000);
 try{
  const ss=SpreadsheetApp.openById(id),original=ss.getSheetByName(LANGUAGE_SHEETS_[input.language]),spanish=ss.getSheetByName('Todo en español');
  verifySheet_(original);verifySheet_(spanish);
  const origCell=existingRow_(original,input.requestId),esCell=existingRow_(spanish,input.requestId);
  if(origCell&&esCell)return {ok:true,id:input.requestId,code:original.getRange(origCell.getRow(),codeColumn_(original)).getValues()[0][0]};
  let row;
  if(origCell){row=logicalRow_(original,original.getRange(origCell.getRow(),1,1,HEADERS_.length).getValues()[0]);}
  else{
   const cache=CacheService.getScriptCache(),key='hour-'+Math.floor(Date.now()/3600000),n=Number(cache.get(key)||0);
   if(n>=100)throw new Error('Límite temporal de recepción.');
   const index=INTERESTS_.indexOf(input.interest),local=FORM_LABELS_[input.language];
   const prefix=input.language.toUpperCase(),props=PropertiesService.getScriptProperties(),keySeq='BGM_SEQ_'+prefix;
   const existing=original.getLastRow()>1?original.getRange(2,codeColumn_(original),original.getLastRow()-1,1).getValues().flat():[];
   const highest=existing.reduce((max,value)=>{const found=String(value).match(new RegExp('^'+prefix+'(\\d+)$'));return found?Math.max(max,Number(found[1])):max;},0);
   const seq=Math.max(Number(props.getProperty(keySeq)||0),highest)+1;
   props.setProperty(keySeq,String(seq));
   const receiptCode=prefix+String(seq).padStart(3,'0');
   const url=input.channel==='whatsapp'?'https://wa.me/'+contact.slice(1):input.channel==='telegram'?'https://t.me/'+contact.replace(/^@/,''):input.channel==='email'?'mailto:'+encodeURIComponent(email):'';
   row=[new Date(),name,email,country,input.language,local[13+index],message,'Sí · contacto v2','Nuevo',receiptCode,notes,input.channel,input.channel==='email'?email:contact,input.appointment?'Solicitada · pendiente de confirmar':'No solicitada',input.appointment?preferred:'',input.appointment?zone:'',url,'Original conservado',input.requestId];
   original.getRange(original.getLastRow()+1,1,1,HEADERS_.length).setValues([physicalRow_(original,row.map((v,i)=>i===0?v:literal_(v)))]);
   SpreadsheetApp.flush();cache.put(key,String(n+1),3600);
  }
  // If a previous attempt saved only Original, retry completes Español by ID.
  // Never overwrite the original text or the owner's follow-up fields.
  if(!esCell){
   const es=row.slice(),language=row[4];let missing=false;
   [3,6,10].forEach(i=>{if(!row[i]||language==='es'){es[i]=row[i];return;}try{es[i]=LanguageApp.translate(String(row[i]),'', 'es');}catch(error){es[i]='[Traducción pendiente: consultar Original]';missing=true;}});
   const index=FORM_LABELS_[language].slice(13,20).indexOf(row[5]);
   if(index>=0)es[5]=FORM_LABELS_.es[13+index];
   es[17]=missing?'Pendiente o parcial · revisar Original':language==='es'?'Original en español':'Traducción automática · revisar';
   spanish.getRange(spanish.getLastRow()+1,1,1,HEADERS_.length).setValues([physicalRow_(spanish,es.map((v,i)=>i===0?v:literal_(v)))]);
  }
  [original,spanish].forEach(sh=>{const cell=existingRow_(sh,input.requestId);if(cell){sh.getRange(cell.getRow(),codeFirst_(sh)?2:1).setNumberFormat('yyyy-mm-dd hh:mm:ss');
    if(sh.getRange(1,23).getValue()==='Estado de cita'&&!sh.getRange(cell.getRow(),23).getValue())sh.getRange(cell.getRow(),23).setValue(input.appointment?'Pendiente':'No solicitada');} });
  SpreadsheetApp.flush();return {ok:true,id:input.requestId,code:row[9]};
 }finally{lock.releaseLock();}
}
